{
  "name": "saiwork-workspace",
  "version": "0.1.28",
  "private": true,
  "description": "SaiWork monorepo workspace",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/server",
      "packages/ui",
      "packages/electron-app",
      "packages/tauri-app",
      "packages/opencode-plugin"
    ]
  },
  "scripts": {
    "dev": "npm run dev --workspace @saiwork/electron-app",
    "dev:electron": "npm run dev --workspace @saiwork/electron-app",
    "dev:tauri": "npm run dev --workspace @saiwork/tauri-app",
    "build": "npm run build --workspace @saiwork/electron-app",
    "build:tauri": "npm run build --workspace @saiwork/tauri-app",
    "build:ui": "npm run build --workspace @saiwork/ui",
    "build:mac-x64": "npm run build:mac-x64 --workspace @saiwork/electron-app",
    "build:binaries": "npm run build:binaries --workspace @saiwork/electron-app",
    "typecheck": "npm run typecheck --workspace @saiwork/saiwork && npm run typecheck --workspace @saiwork/ui && npm run typecheck --workspace @saiwork/electron-app",
    "test": "npm run test --workspace @saiwork/ui && npm run test --workspace @saiwork/saiwork && npm run test --workspace @saiwork/opencode-plugin && npm run test:native --workspace @saiwork/electron-app",
    "test:release": "node --test ./scripts/bump-version.test.js ./scripts/check-release-consistency.test.js",
    "release:check": "npm run test:release && node ./scripts/check-release-consistency.js && npm run typecheck",
    "bumpVersion": "node ./scripts/bump-version.js"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "google-auth-library": "^10.5.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "baseline-browser-mapping": "^2.9.11",
    "electron": "38.0.0",
    "proper-lockfile": "4.1.2",
    "semver": "7.7.2",
    "yauzl": "2.10.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.52.5",
    "@rollup/rollup-darwin-x64": "4.52.5",
    "@rollup/rollup-linux-arm64-gnu": "4.52.5",
    "@rollup/rollup-linux-x64-gnu": "4.52.5",
    "@rollup/rollup-win32-arm64-msvc": "4.52.5",
    "@rollup/rollup-win32-x64-msvc": "4.52.5"
  }
}
